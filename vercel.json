{
  "redirects": [
    { "source": "/a/:page(.+\\.html)", "destination": "/:page", "permanent": false }
  ],
  "rewrites": [
    { "source": "/case-study/signal-detection", "destination": "/case-study-signal-detection.html" },
    { "source": "/case-study/content-system", "destination": "/case-study-content-system.html" },
    { "source": "/case-study/operational-visibility", "destination": "/case-study-operational-visibility.html" },
    { "source": "/blog/:slug", "destination": "/api/og?slug=:slug" },
    { "source": "/a/css/:path*", "destination": "/css/:path*" },
    { "source": "/a/js/:path*", "destination": "/js/:path*" },
    { "source": "/a/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/a/data/:path*", "destination": "/data/:path*" },
    { "source": "/a/outcome", "destination": "/outcome-pricing.html" },
    { "source": "/a/:campaign", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
