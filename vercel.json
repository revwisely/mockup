{
  "redirects": [
    { "source": "/a/:page(.+\\.html)", "destination": "/:page", "permanent": false },
    { "source": "/blog/how-to-teach-ai-your-brand-voice", "destination": "/blog/taste-does-not-fit-in-a-document", "permanent": true }
  ],
  "rewrites": [
    { "source": "/playbooks", "destination": "/playbooks.html" },
    { "source": "/playbook/meeting-intelligence", "destination": "/playbook-meeting-intelligence.html" },
    { "source": "/playbook/stalled-build-handoff", "destination": "/playbook-stalled-build-handoff.html" },
    { "source": "/playbook/ai-ready-data", "destination": "/playbook-ai-ready-data.html" },
    { "source": "/k/meeting-intelligence", "destination": "/assets/kits/meeting-intelligence-kit.zip" },
    { "source": "/k/stalled-build-handoff", "destination": "/assets/kits/stalled-build-handoff-kit.zip" },
    { "source": "/k/ai-ready-data", "destination": "/assets/kits/ai-ready-data-kit.zip" },
    { "source": "/playbook/inbound-signup-routing", "destination": "/playbook-inbound-signup-routing.html" },
    { "source": "/playbook/reply-triage", "destination": "/playbook-reply-triage.html" },
    { "source": "/playbook/crm-enrichment-review", "destination": "/playbook-crm-enrichment-review.html" },
    { "source": "/k/inbound-signup-routing", "destination": "/assets/kits/inbound-signup-routing-kit.zip" },
    { "source": "/k/reply-triage", "destination": "/assets/kits/reply-triage-kit.zip" },
    { "source": "/k/crm-enrichment-review", "destination": "/assets/kits/crm-enrichment-review-kit.zip" },
    { "source": "/playbook/brand-voice-context-layer", "destination": "/playbook-brand-voice-context-layer.html" },
    { "source": "/k/brand-voice-context-layer", "destination": "/assets/kits/brand-voice-context-layer-kit.zip" },
    { "source": "/case-study/signal-detection", "destination": "/case-study-signal-detection.html" },
    { "source": "/case-study/content-system", "destination": "/case-study-content-system.html" },
    { "source": "/case-study/operational-visibility", "destination": "/case-study-operational-visibility.html" },
    { "source": "/blog/:slug", "destination": "/api/og?slug=:slug" },
    { "source": "/a/css/:path*", "destination": "/css/:path*" },
    { "source": "/a/js/:path*", "destination": "/js/:path*" },
    { "source": "/a/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/a/data/:path*", "destination": "/data/:path*" },
    { "source": "/a/outcome", "destination": "/outcome-pricing.html" },
    { "source": "/a/:campaign", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
